         Exclude FlutterSharedPreferences.xml entirely to prevent cloud backup of
         sensitive financial profiles, anonymous installation IDs, and administrative tokens. -->
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
</full-backup-content>
