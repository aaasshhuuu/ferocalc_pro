# FeroCalc Backend Configuration — Verified FD Rate Engine
# Copy to .env.local and fill in actual values.
# NEVER commit .env.local to git.

NODE_ENV=development
PORT=3001

# ============================================================
# Legacy JSON rate API (existing, unchanged)
# ============================================================

ADMIN_API_KEY=your-secure-admin-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_ADMIN=10

# ============================================================
# Supabase — Verified FD Rate Engine (Phase A)
# ============================================================
# Obtain these from: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (safe to expose in server env only)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key: used for public verified-rate queries (RLS enforces VERIFIED-only)
# This key is safe for server-to-Supabase calls but must NOT be put in Flutter Web.
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key: bypasses RLS — used exclusively for admin write operations.
# CRITICAL: This key MUST NEVER be exposed to the Flutter Web client.
# It must only be set as a server-side environment variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
